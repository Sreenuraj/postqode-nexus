# Copy to .env and adjust as needed. .env is gitignored.

BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

USER_USERNAME=user
USER_PASSWORD=User@123

# true = headless (default for CI/autonomous runs), false = headed for debugging
HEADLESS=true

# Postgres (read-only verification queries only)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus
DB_USER=nexus
DB_PASSWORD=nexus
